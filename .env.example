# Client-side configuration
# No database or API keys required - queries public NY Fed & Ethereum RPC/subgraph endpoints directly from browser.

# Optional GitHub Actions Background Monitor (.github/workflows/fed-alerts.yml)
# Store NTFY_TOPIC as a GitHub Repository Secret (never commit your real topic name).
NTFY_TOPIC=
DASHBOARD_URL=https://scribblerr17.github.io/Macro-command-centre/
SPREAD_BPS_THRESHOLD=15
SRF_BILLIONS_THRESHOLD=25
SOFR_JUMP_BPS_THRESHOLD=5
STRESS_SCORE_THRESHOLD=65
